# InPick iOS — fastlane 환경변수 템플릿
# 다음 주 Apple 유료 개발자 등록 후 이 파일을 복사해서 채우세요:
#   cp fastlane/.env.example fastlane/.env
# ⚠️ fastlane/.env 와 *.p8 는 절대 git 에 커밋하지 마세요 (.gitignore 처리됨).

# --- App Store Connect API Key (권장: 2FA 없이 자동화) ---
# App Store Connect → 사용자 및 액세스 → 통합 → 키 에서 발급(.p8 다운로드)
ASC_KEY_ID=                       # 예: ABC123DEF4
ASC_ISSUER_ID=                    # 예: 12a3b4c5-...
ASC_KEY_FILEPATH=./fastlane/AuthKey_XXXXXXXXXX.p8   # 다운받은 .p8 경로

# --- 팀/계정 (자동 서명용) ---
DEVELOPER_TEAM_ID=                # Apple Developer 포털 팀 ID (10자리)
APPLE_ID=                         # 애플 개발자 계정 이메일 (선택)
ASC_TEAM_ID=                      # App Store Connect 팀 ID (선택)

# --- 빌드 번호 폴백 (TestFlight 조회 실패 시 사용) ---
BUILD_NUMBER=0
