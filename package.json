    "lenis": "^1.3.23",
    "lucide-react": "^0.563.0",
    "motion": "^12.34.0",
    "next": "14.2.35",
    "next-intl": "^4.8.2",
    "onnxruntime-web": "^1.24.1",
    "pdf-lib": "^1.17.1",
