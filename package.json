{
  "name": "inpick-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "dev:ai": "cd python/floorplan-ai && python main.py serve --port 8100",
    "dev:parser": "cd services/pdf_parser && python main.py serve --port 8101",
    "dev:full": "concurrently \"npm run dev\" \"npm run dev:ai\"",
    "dev:full-v47": "concurrently \"npm run dev\" \"npm run dev:parser\"",
    "mobile:init": "npx cap init InPick kr.inpick.app --web-dir=public",
    "mobile:add:ios": "npx cap add ios",
    "mobile:add:android": "npx cap add android",
    "mobile:sync": "npx cap sync",
    "mobile:assets": "npx @capacitor/assets generate --iconBackgroundColor '#FFFFFF' --iconBackgroundColorDark '#1A1F2E' --splashBackgroundColor '#F73B20' --splashBackgroundColorDark '#F73B20'",
    "mobile:open:ios": "npx cap open ios",
    "mobile:open:android": "npx cap open android",
    "runpod:sam31:smoke": "node scripts/runpod-sam31-smoke.mjs"
  },
