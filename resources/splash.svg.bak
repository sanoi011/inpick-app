<?xml version="1.0" encoding="UTF-8"?>
<!--
  Splash Screen — 1920×1920 (Capacitor 자동 리사이징 → 다양한 디바이스)
  다홍색 배경 + 가운데 흰 6각형 + InPick 워드마크
-->
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1920 1920" width="1920" height="1920">
  <!-- 다홍색 배경 -->
  <rect width="1920" height="1920" fill="#F73B20"/>

  <!-- 가운데 흰 6각형 (~480px) -->
  <g transform="translate(720, 720)">
    <polygon
      points="120,32 360,32 480,240 360,448 120,448 0,240"
      fill="#FFFFFF"
    />
  </g>

  <!-- 워드마크 'inpick' -->
  <text
    x="960"
    y="1320"
    text-anchor="middle"
    font-family="Inter, -apple-system, BlinkMacSystemFont, sans-serif"
    font-weight="900"
    font-size="140"
    fill="#FFFFFF"
    letter-spacing="-5"
  >inpick</text>

  <!-- 부제 -->
  <text
    x="960"
    y="1400"
    text-anchor="middle"
    font-family="Inter, sans-serif"
    font-weight="500"
    font-size="48"
    fill="#FFFFFF"
    fill-opacity="0.85"
    letter-spacing="2"
  >AI 인테리어 견적 플랫폼</text>
</svg>
