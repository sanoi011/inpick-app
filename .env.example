# Site (정식 www 도메인 이전 시 NEXT_PUBLIC_SITE_URL 갱신)
NEXT_PUBLIC_SITE_URL=https://www.inpick.kr

# ───────────────────────────────────────────────────────────
# Supabase (REQUIRED)
# ───────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ───────────────────────────────────────────────────────────
# AI Provider Policy (2026-05-10 정책)
# default: anthropic_openai_runpod_only — Gemini 차단
# 다른 옵션: openai_only / anthropic_only / all_allowed (dev 전용)
# ───────────────────────────────────────────────────────────
AI_PROVIDER_POLICY=anthropic_openai_runpod_only

# ───────────────────────────────────────────────────────────
# Anthropic Claude API (REQUIRED — 채팅/상담)
# https://console.anthropic.com
# ───────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your-anthropic-api-key

# ───────────────────────────────────────────────────────────
# OpenAI API (REQUIRED — 이미지 생성/Vision)
# https://platform.openai.com
# ───────────────────────────────────────────────────────────
OPENAI_API_KEY=your-openai-api-key

# ───────────────────────────────────────────────────────────
# RunPod Serverless (OPTIONAL — Flux 이미지 생성, SAM 세그멘테이션)
# ───────────────────────────────────────────────────────────
RUNPOD_API_KEY=
RUNPOD_FLUX_ENDPOINT=
RUNPOD_SYNC_ENDPOINT=
RUNPOD_ASYNC_ENDPOINT=

# ───────────────────────────────────────────────────────────
# Image Generation Backend (OPTIONAL — 정책별 분기)
# IMAGE_GEN_BACKEND: openai (default) | runpod | auto
# IMAGE_GEN_MODE: sync (default) | async
# INPICK_EVAL_REPORT_PASSED: production에서 backend!=openai로 변경 시 "true" 필수
# ───────────────────────────────────────────────────────────
IMAGE_GEN_BACKEND=openai
IMAGE_GEN_MODE=sync
INPICK_EVAL_REPORT_PASSED=
INPICK_IMAGE_MODEL_ID=black-forest-labs/FLUX.2-klein-4b
OPENAI_IMAGE_FALLBACK_ENABLED=true
BFL_COMMERCIAL_LICENSE_CONFIRMED=

# ───────────────────────────────────────────────────────────
# Image Storage (OPTIONAL — production에서 base64 차단 시 필수)
# ───────────────────────────────────────────────────────────
IMAGE_STORAGE_PROVIDER=supabase
IMAGE_STORAGE_BUCKET=renders
IMAGE_PUBLIC_BASE_URL=

# ───────────────────────────────────────────────────────────
# 외부 데이터 API
# ───────────────────────────────────────────────────────────
JUSO_API_KEY=your-juso-api-key

# ───────────────────────────────────────────────────────────
# Naver Login (OPTIONAL — 네이버 소셜 로그인)
# https://developers.naver.com/apps/ — Application 등록 후 Client ID/Secret 발급
# 콜백 URL 등록: https://<domain>/api/auth/naver/callback
# (로컬: http://localhost:3000/api/auth/naver/callback)
# ───────────────────────────────────────────────────────────
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ───────────────────────────────────────────────────────────
# Toss Payments (OPTIONAL — 미설정 시 Mock 모드)
# https://developers.tosspayments.com
# ───────────────────────────────────────────────────────────
TOSS_PAYMENTS_CLIENT_KEY=
TOSS_PAYMENTS_SECRET_KEY=
TOSS_WEBHOOK_SECRET=

# ───────────────────────────────────────────────────────────
# Python 서비스 (LOCAL DEV — production에서 미사용)
# ───────────────────────────────────────────────────────────
FLOORPLAN_AI_URL=http://localhost:8100
PDF_PARSER_V47_URL=http://localhost:8101

# ───────────────────────────────────────────────────────────
# 관리자
# ───────────────────────────────────────────────────────────
ADMIN_PASSWORD=your-admin-password

# ───────────────────────────────────────────────────────────
# DEPRECATED — 사용 중지 (2026-05-10)
# ───────────────────────────────────────────────────────────
# Google Gemini API: InPick에서 사용하지 않습니다.
# AI_PROVIDER_POLICY=anthropic_openai_runpod_only 정책에 의해 차단됨.
# Vercel 환경변수에서 제거 권장.
# 이전 키가 있어도 docs/ops/GEMINI_REMOVAL_AUDIT.md 참조하여 이전.
# GOOGLE_GEMINI_API_KEY=
