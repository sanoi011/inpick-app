# Vision Materials worker — GPU base (Phase 3 후속).
#
# 빌드:
#   docker build -f Dockerfile.gpu -t inpick-vision-materials:gpu .
#
# 환경변수:
#   VISION_MATERIALS_LOAD_MODELS=true (실제 모델 로드 활성)
#
# 권장 GPU: 16GB 이상 (A4000/A5000/A10/RTX 4090)
FROM pytorch/pytorch:2.3.0-cuda12.1-cudnn8-runtime

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV VISION_MATERIALS_LOAD_MODELS=true
ENV VISION_MATERIALS_ENABLE_OCR=false
ENV VISION_MATERIALS_MAX_BATCH=24
ENV HF_HOME=/root/.cache/huggingface

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        libgl1 libglib2.0-0 ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && python -m pip install --no-cache-dir --upgrade pip

WORKDIR /app

# CPU base requirements
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# GPU 전용 — base image에 torch/torchvision/CUDA가 포함되어 있다.
RUN pip install --no-cache-dir \
    open-clip-torch==2.26.1

# 모델 가중치를 이미지에 포함해 RunPod cold start 중 외부 다운로드를 없앤다.
RUN python -c "import open_clip; open_clip.create_model_and_transforms('ViT-B-32', pretrained='laion2b_s34b_b79k', device='cpu')"

# Phase 후속에서 활성화:
# RUN pip install --no-cache-dir \
#     groundingdino-py>=0.4.0
# RUN git clone https://github.com/facebookresearch/sam2 && cd sam2 && pip install -e .
# RUN mkdir -p /models && \
#     wget -O /models/groundingdino_swint_ogc.pth https://github.com/IDEA-Research/GroundingDINO/releases/download/v0.1.0-alpha/groundingdino_swint_ogc.pth

# 앱 소스
COPY schemas.py .
COPY handler.py .
COPY pipelines/ ./pipelines/
COPY storage/ ./storage/

CMD ["python", "-u", "handler.py"]
