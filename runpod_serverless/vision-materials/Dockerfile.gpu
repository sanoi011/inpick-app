# Vision Materials worker — GPU base (Phase 3 후속).
#
# 빌드:
#   docker build -f Dockerfile.gpu -t inpick-vision-materials:gpu .
#
# 환경변수:
#   VISION_MATERIALS_LOAD_MODELS=true (실제 모델 로드 활성)
#
# 권장 GPU: A10G / RTX 4090 / A100
FROM nvidia/cuda:12.1.0-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV VISION_MATERIALS_LOAD_MODELS=true

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        python3.11 python3.11-venv python3-pip \
        libgl1 libglib2.0-0 ca-certificates curl wget \
    && rm -rf /var/lib/apt/lists/* \
    && update-alternatives --install /usr/bin/python python /usr/bin/python3.11 1 \
    && update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.11 1

WORKDIR /app

# CPU base requirements
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# GPU 전용 — torch + open_clip + easyocr (heavy)
# 현재는 CPU base에도 실행되도록 lazy import (handler.py가 graceful degrade)
RUN pip install --no-cache-dir \
    torch==2.3.0 \
    torchvision==0.18.0 \
    open-clip-torch>=2.24.0 \
    easyocr>=1.7.1 \
    transformers>=4.44.0

# Phase 후속에서 활성화:
# RUN pip install --no-cache-dir \
#     groundingdino-py>=0.4.0
# RUN git clone https://github.com/facebookresearch/sam2 && cd sam2 && pip install -e .
# RUN mkdir -p /models && \
#     wget -O /models/groundingdino_swint_ogc.pth https://github.com/IDEA-Research/GroundingDINO/releases/download/v0.1.0-alpha/groundingdino_swint_ogc.pth

# 앱 소스
COPY schemas.py .
COPY handler.py .
COPY pipelines/ ./pipelines/
COPY storage/ ./storage/

CMD ["python", "-u", "handler.py"]
